# Local dev secrets for `npm run dev` (wrangler dev reads this file; never commit it).
# Copy to .dev.vars and fill in. On the live Worker the same three names are set with
#   npx wrangler secret put SIGNING_SECRET   (etc.)
# Anything long and random works for the secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

SIGNING_SECRET=
ADMIN_PASSWORD=admin123
# Optional second lock on the upload endpoints (/api/dashboard/uploads…): also needs this as the
# `X-Api-Key` header. Leave EMPTY for a web dashboard — the admin login token already protects uploads,
# and a same-origin dashboard cannot hold this key privately (set it and uploads 401 + log you out).
API_KEY=

# Only the one-off Mongo→D1 data migration needs this (scripts/migrate-mongo-to-d1.mjs);
# the Worker itself never talks to MongoDB.
MONGODB_URI=
